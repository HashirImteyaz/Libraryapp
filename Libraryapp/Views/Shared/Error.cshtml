@model Libraryapp.Models.ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div style="max-width:600px;margin:3rem auto;padding:0 1.5rem;text-align:center">
    <div style="font-size:3rem;margin-bottom:1rem">⚠️</div>
    <h1 style="font-size:1.5rem;font-weight:700;margin-bottom:0.5rem">Something went wrong</h1>
    <p style="color:#94a3b8;margin-bottom:1.5rem">An unexpected error occurred. Please try again.</p>
    @if (Model?.ShowRequestId == true)
    {
        <p style="font-size:0.8rem;color:#475569">
            Request ID: <code style="background:rgba(255,255,255,0.08);padding:2px 8px;border-radius:6px">@Model.RequestId</code>
        </p>
    }
    <a href="/Home/Index" style="display:inline-block;margin-top:1.5rem;padding:10px 24px;background:linear-gradient(135deg,#6c63ff,#a78bfa);border-radius:10px;color:white;text-decoration:none;font-weight:600">
        ← Back to Dashboard
    </a>
</div>
