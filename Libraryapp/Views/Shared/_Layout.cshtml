<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@(ViewData["Title"] != null ? ViewData["Title"] + " — LibraryApp" : "LibraryApp")</title>
    <meta name="description" content="Library Management System — manage books, students, and borrowing records." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --bg: #0d0f1a;
            --surface: rgba(255,255,255,0.05);
            --surface-hover: rgba(255,255,255,0.09);
            --border: rgba(255,255,255,0.1);
            --accent: #6c63ff;
            --accent2: #a78bfa;
            --text: #e2e8f0;
            --text-muted: #94a3b8;
            --danger: #f87171;
            --success: #34d399;
            --nav-height: 64px;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
        }

        /* ── NAV ── */
        nav.topnav {
            position: fixed; top: 0; left: 0; right: 0; z-index: 100;
            height: var(--nav-height);
            background: rgba(13,15,26,0.85);
            backdrop-filter: blur(16px);
            border-bottom: 1px solid var(--border);
            display: flex; align-items: center; justify-content: space-between;
            padding: 0 2rem;
        }

        .nav-brand {
            display: flex; align-items: center; gap: 10px;
            font-size: 1.25rem; font-weight: 700;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            -webkit-background-clip: text; -webkit-text-fill-color: transparent;
            text-decoration: none;
        }

        .nav-brand .brand-icon {
            width: 32px; height: 32px; border-radius: 8px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex; align-items: center; justify-content: center;
            font-size: 1rem;
        }
        .nav-brand .brand-icon span { -webkit-text-fill-color: white; }

        .nav-right {
            display: flex; align-items: center; gap: 1rem;
        }

        .nav-user {
            display: flex; align-items: center; gap: 8px;
            font-size: 0.875rem; color: var(--text-muted);
        }

        .nav-user .avatar {
            width: 34px; height: 34px; border-radius: 50%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex; align-items: center; justify-content: center;
            font-weight: 600; font-size: 0.85rem; color: white;
        }

        .btn-nav-logout {
            background: transparent;
            border: 1px solid var(--border);
            color: var(--text-muted);
            padding: 6px 16px;
            border-radius: 8px;
            font-size: 0.8rem;
            cursor: pointer;
            transition: all 0.2s;
        }
        .btn-nav-logout:hover { background: var(--surface-hover); color: var(--text); }

        /* ── MAIN CONTENT ── */
        main.page-content {
            padding-top: calc(var(--nav-height) + 2rem);
            min-height: 100vh;
        }

        /* ── ALERTS (global) ── */
        .alert {
            border-radius: 10px; padding: 14px 18px;
            font-size: 0.9rem; margin-bottom: 1rem;
            border: 1px solid;
        }
        .alert-success { background: rgba(52,211,153,0.1); border-color: rgba(52,211,153,0.3); color: var(--success); }
        .alert-danger  { background: rgba(248,113,113,0.1); border-color: rgba(248,113,113,0.3); color: var(--danger); }
    </style>
    @await RenderSectionAsync("Styles", required: false)
</head>
<body>
    @if (User.Identity?.IsAuthenticated == true)
    {
        <nav class="topnav">
            <a href="/Home/Index" class="nav-brand">
                <div class="brand-icon"><span>📚</span></div>
                LibraryApp
            </a>
            <div class="nav-right">
                <div class="nav-user">
                    <div class="avatar">@(User.Identity.Name?.Substring(0,1).ToUpper())</div>
                    <span>@User.Identity.Name</span>
                </div>
                <form asp-controller="Account" asp-action="Logout" method="post" style="margin:0">
                    <button type="submit" class="btn-nav-logout">Sign Out</button>
                </form>
            </div>
        </nav>
    }

    <main class="page-content">
        @if (TempData["SuccessMessage"] != null)
        {
            <div style="max-width:600px;margin:0 auto 1rem;padding:0 1.5rem">
                <div class="alert alert-success">✅ @TempData["SuccessMessage"]</div>
            </div>
        }
        @RenderBody()
    </main>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
