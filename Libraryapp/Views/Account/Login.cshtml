@model Libraryapp.Models.LoginViewModel
@{
    ViewData["Title"] = "Sign In";
    Layout = null; // Full-page design — no nav needed
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Sign In — LibraryApp</title>
    <meta name="description" content="Sign in to LibraryApp to manage books, students, and borrowing records." />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        :root {
            --accent: #6c63ff;
            --accent2: #a78bfa;
            --bg: #0d0f1a;
            --text: #e2e8f0;
            --text-muted: #94a3b8;
            --danger: #f87171;
            --success: #34d399;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            position: relative;
        }

        /* Animated gradient orbs */
        .bg-orb {
            position: fixed;
            border-radius: 50%;
            filter: blur(80px);
            opacity: 0.25;
            animation: drift 12s ease-in-out infinite alternate;
            pointer-events: none;
            z-index: 0;
        }
        .orb1 { width: 520px; height: 520px; background: var(--accent); top: -180px; left: -160px; animation-delay: 0s; }
        .orb2 { width: 400px; height: 400px; background: #ec4899; bottom: -140px; right: -100px; animation-delay: 4s; }
        .orb3 { width: 300px; height: 300px; background: var(--accent2); top: 50%; left: 60%; animation-delay: 8s; }

        @@keyframes drift {
            from { transform: translate(0, 0) scale(1); }
            to   { transform: translate(30px, 20px) scale(1.08); }
        }

        /* Card */
        .card {
            position: relative; z-index: 10;
            width: 100%; max-width: 420px;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 24px;
            padding: 2.5rem 2.5rem 2rem;
            box-shadow: 0 25px 50px rgba(0,0,0,0.5);
            animation: slideUp 0.5s cubic-bezier(0.16,1,0.3,1) both;
        }

        @@keyframes slideUp {
            from { opacity: 0; transform: translateY(24px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Brand */
        .brand {
            display: flex; align-items: center; gap: 12px;
            margin-bottom: 2rem;
        }
        .brand-icon {
            width: 48px; height: 48px; border-radius: 14px;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            display: flex; align-items: center; justify-content: center;
            font-size: 1.5rem;
            box-shadow: 0 8px 24px rgba(108,99,255,0.4);
        }
        .brand-text h1 { font-size: 1.3rem; font-weight: 700; }
        .brand-text p { font-size: 0.78rem; color: var(--text-muted); }

        /* Heading */
        .card-heading {
            font-size: 1.5rem; font-weight: 700;
            margin-bottom: 0.35rem;
        }
        .card-sub {
            font-size: 0.875rem; color: var(--text-muted);
            margin-bottom: 1.75rem;
        }

        /* Success message */
        .msg-success {
            background: rgba(52,211,153,0.12);
            border: 1px solid rgba(52,211,153,0.3);
            border-radius: 10px;
            padding: 12px 16px;
            color: var(--success);
            font-size: 0.875rem;
            margin-bottom: 1.25rem;
            display: flex; align-items: center; gap: 8px;
        }

        /* Error summary */
        .error-summary {
            background: rgba(248,113,113,0.1);
            border: 1px solid rgba(248,113,113,0.3);
            border-radius: 10px;
            padding: 12px 16px;
            color: var(--danger);
            font-size: 0.875rem;
            margin-bottom: 1.25rem;
        }
        .error-summary ul { margin: 0; padding-left: 1rem; }

        /* Form */
        .form-group {
            margin-bottom: 1.1rem;
        }
        label {
            display: block;
            font-size: 0.8rem;
            font-weight: 500;
            color: var(--text-muted);
            margin-bottom: 6px;
            text-transform: uppercase;
            letter-spacing: 0.05em;
        }
        input[type="text"],
        input[type="password"] {
            width: 100%;
            background: rgba(255,255,255,0.06);
            border: 1px solid rgba(255,255,255,0.12);
            border-radius: 12px;
            padding: 12px 16px;
            font-size: 0.95rem;
            font-family: 'Inter', sans-serif;
            color: var(--text);
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        input:focus {
            border-color: var(--accent);
            box-shadow: 0 0 0 3px rgba(108,99,255,0.18);
        }
        input::placeholder { color: rgba(255,255,255,0.25); }
        .field-error {
            color: var(--danger);
            font-size: 0.78rem;
            margin-top: 5px;
        }

        /* Remember me */
        .remember-row {
            display: flex; align-items: center; gap: 8px;
            margin-bottom: 1.5rem;
        }
        .remember-row input[type="checkbox"] {
            width: 16px; height: 16px;
            accent-color: var(--accent);
        }
        .remember-row label {
            margin: 0; text-transform: none; letter-spacing: 0;
            font-size: 0.875rem; color: var(--text-muted);
        }

        /* Submit button */
        .btn-primary {
            width: 100%;
            background: linear-gradient(135deg, var(--accent), var(--accent2));
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-size: 0.95rem;
            font-weight: 600;
            font-family: 'Inter', sans-serif;
            color: white;
            cursor: pointer;
            transition: opacity 0.2s, transform 0.15s, box-shadow 0.2s;
            box-shadow: 0 6px 20px rgba(108,99,255,0.35);
            margin-bottom: 1.5rem;
        }
        .btn-primary:hover {
            opacity: 0.92;
            transform: translateY(-1px);
            box-shadow: 0 10px 28px rgba(108,99,255,0.45);
        }
        .btn-primary:active { transform: translateY(0); }

        /* Footer link */
        .card-footer {
            text-align: center;
            font-size: 0.875rem;
            color: var(--text-muted);
        }
        .card-footer a {
            color: var(--accent2);
            text-decoration: none;
            font-weight: 500;
            transition: color 0.2s;
        }
        .card-footer a:hover { color: var(--accent); }

        /* Divider */
        .divider {
            height: 1px;
            background: rgba(255,255,255,0.08);
            margin: 1.5rem 0;
        }
    </style>
</head>
<body>
    <!-- Background orbs -->
    <div class="bg-orb orb1"></div>
    <div class="bg-orb orb2"></div>
    <div class="bg-orb orb3"></div>

    <div class="card">
        <!-- Brand -->
        <div class="brand">
            <div class="brand-icon">📚</div>
            <div class="brand-text">
                <h1>LibraryApp</h1>
                <p>Library Management System</p>
            </div>
        </div>

        <div class="card-heading">Welcome back</div>
        <div class="card-sub">Sign in to your account to continue</div>

        <!-- Success message after registration -->
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="msg-success">✅ @TempData["SuccessMessage"]</div>
        }

        <!-- Validation summary -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="error-summary">
                <asp-validation-summary asp-validation-summary="All"></asp-validation-summary>
            </div>
        }

        <form asp-action="Login" asp-controller="Account" method="post">
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" type="text" placeholder="Enter your username" autocomplete="username" id="login-username" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password">Password</label>
                <input asp-for="Password" type="password" placeholder="Enter your password" autocomplete="current-password" id="login-password" />
                <span asp-validation-for="Password" class="field-error"></span>
            </div>

            <div class="remember-row">
                <input asp-for="RememberMe" type="checkbox" id="login-remember" />
                <label asp-for="RememberMe">Remember me for 7 days</label>
            </div>

            <button type="submit" class="btn-primary" id="login-submit">Sign In →</button>
        </form>

        <div class="divider"></div>

        <div class="card-footer">
            Don't have an account? <a href="/Account/Register" id="go-register">Create one here</a>
        </div>
    </div>
</body>
</html>
